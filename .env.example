# -----------------------------------------------------------------------------
# n8n-hubspot-probability-weighted-forecast-calculator
# Copy to .env (never commit it). Secret and ID values ship blank on purpose:
# fill them in locally only.
# Standalone engine: node --env-file=.env src/index.js
# n8n: set the non-secret settings as n8n environment variables. HubSpot and
# Google Sheets access is configured as n8n credentials, not here.
# -----------------------------------------------------------------------------

# --- Safety gates (fail-safe defaults) ---------------------------------------
# Only the literal string "false" turns a safety flag off.
# DRY_RUN=true: calculate and preview only; nothing is written anywhere.
DRY_RUN=true
# SANDBOX_MODE=true: read HubSpot only from a verified SANDBOX / DEVELOPER_TEST
# portal, and write only to GOOGLE_SHEETS_SANDBOX_ID.
SANDBOX_MODE=true
# Required for SANDBOX_MODE=false (production deals, production spreadsheet).
ALLOW_PRODUCTION_MODE=false

# --- HubSpot -------------------------------------------------------------------
# Private app access token (standalone engine only). Scopes: crm.objects.deals.read
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com
# Optional: pin sandbox reads to one portal ID (numeric).
HUBSPOT_SANDBOX_PORTAL_ID=
# Optional: comma-separated pipeline IDs to forecast (blank = all pipelines).
PIPELINE_IDS=
# Maximum pages of 50 deals to read per run.
MAX_DEAL_PAGES=200

# --- Forecast method -------------------------------------------------------------
# Closed deals with a close date in this window form the historical cohort.
LOOKBACK_DAYS=365
# Beta prior strength toward each stage's static HubSpot probability (0 = raw history).
PRIOR_STRENGTH=10
# Stages with fewer closed deals than this are flagged low-confidence.
MIN_SAMPLE_SIZE=20
# Force win probability to be non-decreasing by stage order.
ENFORCE_MONOTONIC=true
# month | quarter
FORECAST_PERIOD=month
FORECAST_PERIODS_AHEAD=6
REPORT_TIMEZONE=UTC

# --- Google Sheets ---------------------------------------------------------------
# Spreadsheet IDs (the long ID in each sheet's URL). Must be two different sheets.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_SANDBOX_ID=
# Standalone engine only: path to a service account JSON key file kept OUTSIDE this repo.
GOOGLE_SERVICE_ACCOUNT_FILE=
SUMMARY_TAB=Forecast Summary
STAGE_TAB=Stage Probabilities
PERIOD_TAB=Forecast by Period

# --- Executive dashboard (optional) ----------------------------------------------
# HTTPS endpoint that receives the summary rows as JSON after each written run.
DASHBOARD_WEBHOOK_URL=
